# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated registry sources (rebuilt by `pnpm registry` / predev / prebuild)
/src/registry/__generated__/

# private notes — not for the public repo (agent workflow, internal research, dev log)
/.claude/
/.omc/
/CLAUDE.md
/docs/agents/
/docs/arastirma/
/docs/gelisim-gunlugu.md
